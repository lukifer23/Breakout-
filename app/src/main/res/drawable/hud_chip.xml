<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="110"
                android:startColor="@color/bp_hud_glass_fill_strong"
                android:endColor="@color/bp_hud_glass_fill_deep" />
            <corners android:radius="@dimen/bp_radius_glass_compact" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/bp_hud_glass_stroke" />
            <corners android:radius="@dimen/bp_radius_glass_compact" />
            <solid android:color="@color/bp_transparent" />
        </shape>
    </item>
</layer-list>
