<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/menu_background" />

    <item android:gravity="center">
        <inset
            android:insetLeft="68dp"
            android:insetRight="68dp"
            android:insetTop="68dp"
            android:insetBottom="68dp">
            <shape android:shape="rectangle">
                <corners android:radius="30dp" />
                <gradient
                    android:angle="130"
                    android:startColor="@color/bp_glass_fill_strong"
                    android:endColor="@color/bp_glass_fill" />
                <stroke
                    android:width="1.5dp"
                    android:color="@color/bp_glass_stroke_bright" />
            </shape>
        </inset>
    </item>
</layer-list>
