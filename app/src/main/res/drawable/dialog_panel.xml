<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/bp_glass_fill_strong"
                android:endColor="@color/bp_glass_fill" />
            <corners android:radius="@dimen/bp_radius_glass" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/bp_glass_stroke_bright" />
            <corners android:radius="@dimen/bp_radius_glass" />
            <solid android:color="@color/bp_transparent" />
        </shape>
    </item>
</layer-list>
