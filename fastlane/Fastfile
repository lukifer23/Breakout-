require_relative "release_contract"

default_platform(:android)

platform :android do
  desc "Build signed release AAB locally (no Play credentials needed)"
  lane :build_release do
    BreakoutRelease.require_signing!
    gradle(task: "bundle", build_type: "Release")
  end

  desc "Validate minified APK and AAB, debug signed with .compilecheck application ID"
  lane :compile_check do
    gradle(task: "assembleReleaseCheck bundleReleaseCheck")
  end

  desc "Build and upload signed AAB and metadata to the internal track as draft"
  lane :upload_internal do
    key = BreakoutRelease.require_play_key!
    build_release
    supply(json_key: key, aab: BreakoutRelease.aab_path, track: "internal",
           release_status: "draft", skip_upload_apk: true)
  end

  desc "Build and publish signed AAB to internal track"
  lane :publish_internal do
    key = BreakoutRelease.require_play_key!
    build_release
    supply(json_key: key, aab: BreakoutRelease.aab_path, track: "internal",
           release_status: "completed", skip_upload_apk: true)
  end

  desc "Publish existing internal release for the authoritative version code"
  lane :publish_internal_existing do
    supply(json_key: BreakoutRelease.require_play_key!, track: "internal",
           release_status: "completed", version_code: BreakoutRelease.version_code,
           skip_upload_apk: true, skip_upload_aab: true)
  end

  desc "Upload metadata only (no signing or AAB needed)"
  lane :upload_metadata do
    supply(json_key: BreakoutRelease.require_play_key!, track: "internal",
           release_status: "draft", changes_not_sent_for_review: true,
           version_code: BreakoutRelease.version_code,
           skip_upload_apk: true, skip_upload_aab: true)
  end

  desc "Build and upload signed AAB to internal track as draft"
  lane :build_and_upload_internal do
    upload_internal
  end
end
